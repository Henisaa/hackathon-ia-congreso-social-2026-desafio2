# ============================================================================
# VARIABLES DE ENTORNO PARA VERCEL / DESARROLLO LOCAL (.env)
# ============================================================================
# En Vercel: Ve a Project Settings -> Environment Variables y agrega estas
# variables (o haz clic en "Import .env" y sube tu archivo .env local).
# Nota: .env está en .gitignore por seguridad para no exponer tu clave en GitHub.

# 1. Clave de IA entregada por la Hackathon (Anthropic Claude: empieza con sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-...

# 2. Modelo oficial de la Hackathon (Claude Haiku 5.5)
AI_MODEL=claude-haiku-5-5
AI_PROVIDER=anthropic

# (Alternativa compatible: también puedes usar AI_API_KEY, GROQ_API_KEY o OPENAI_API_KEY)
# AI_API_KEY=sk-ant-...
